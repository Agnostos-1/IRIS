# ─── Supabase ───────────────────────────────────────────────────────────────
# Trouvables dans votre projet Supabase : Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anon-publique

# Clé service_role — NE JAMAIS exposer côté client, utilisée uniquement dans
# les Route Handlers serveur pour contourner Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=votre-clé-service-role-secrète

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Utilisé pour les invitations par email et les liens magiques d'authentification.

RESEND_API_KEY=votre-clé-api-resend
RESEND_FROM_EMAIL=noreply@votredomaine.fr

# ─── Application ────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Cron (rappel J-2) ──────────────────────────────────────────────────────
# Protège /api/cron/reminders — Vercel envoie automatiquement ce secret en
# en-tête Authorization pour les crons déclarés dans vercel.json. Optionnel en
# local (la route reste accessible sans secret si la variable est absente).

CRON_SECRET=un-secret-aléatoire
